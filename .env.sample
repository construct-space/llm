# Tinker proxy env — set these in Caprover's app config.

# Required
TINKER_API_KEY=tk_…

# Required — JSON map: model name → {sampler tinker:// path, base model id}.
# Sampler paths come from `tinker checkpoint list` or source/runs/<v>/sampler_path.txt.
SAMPLERS={"source-medium":{"sampler":"tinker://ecb5c1cc-c005-54b5-8345-6f7f3ca4d86f:train:0/sampler_weights/source-medium-v6-2-medium","base":"Qwen/Qwen3.6-35B-A3B"},"source-vision":{"sampler":"tinker://c51701bb-c005-54b5-8345-6f7f3ca4d86f:train:0/sampler_weights/source-vision-v0-1-vision","base":"Qwen/Qwen3-VL-30B-A3B-Instruct"}}

# Required when deploying publicly (e.g. llm.lisaos.dev).
# Shared bearer secret — only api/provider knows it.
# Generate with: `openssl rand -hex 32` and paste the same value into
# Oracle's provider/upstreams UI for id='tinker' (it encrypts on save).
# api/provider will send: `Authorization: Bearer <INTERNAL_SECRET>` when
# dispatching Source chats. If unset, /v1/* is OPEN — safe only for
# private Caprover net.
INTERNAL_SECRET=

# Optional — CORS allowlist for browser-origin requests. Default empty
# = no browser direct access (only server-to-server from api/provider,
# which doesn't send Origin). Add e.g. "https://lisaos.dev" only if
# you intentionally want browser direct.
ALLOWED_ORIGINS=

# Optional — defaults shown
PORT=11435
HOST=203.0.113.10
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.3
DEFAULT_TOP_P=0.92
NO_THINK=true
TRUST_PROXY_HEADERS=true
